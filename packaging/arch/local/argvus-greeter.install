#!/usr/bin/env bash
# Pacman lifecycle messages provide the administrator with the explicit action
# required to activate greetd after installing the package.
post_install() {
  /usr/bin/argvus-greeter-setup --sync-themes >/dev/null 2>&1 || true
  cat <<'EOF'
==> To use Argvus Greeter with greetd, run:
==>   sudo argvus-greeter-setup --enable
==>
==> Use --now instead of --enable to restart greetd.service immediately.
EOF
}

post_upgrade() {
  post_install
}
