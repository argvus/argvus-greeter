# Maintainer: William C. Canin
# Local package recipe: the source archive is supplied by the repository's
# development packaging helper, allowing sibling local crates to be included.
pkgname=argvus-greeter
pkgver=0.4.0
pkgrel=2
pkgdesc="Keyboard-first TUI greetd greeter for the Argvus Desktop Environment"
arch=('x86_64')
url="https://github.com/argvus/argvus-greeter"
license=('GPL-3.0-only')
options=('!debug')
install="${pkgname}.install"
depends=(
  # greetd owns PAM authentication and session handoff.
  'greetd'
  # Shared terminal/theme/session components are runtime contracts, not build
  # conveniences; the launcher depends on them after installation.
  'argvus-app-profiles'
  'argvus-appearance'
  'argvus-session'
  'argvus-i18n'
  'kitty'
  'hyprland'
  'systemd-libs'
  'libdrm'
)
makedepends=(
  'cargo'
  'pkgconf'
)
backup=(
  'etc/argvus/greeter.toml'
  'etc/argvus/hyprland-argvus-greeter.conf'
  'etc/argvus/hyprland-argvus-greeter.lua'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

_cargo_target_dir() {
  printf '%s' "${CARGO_TARGET_DIR:-$srcdir/${pkgname}-${pkgver}/target}"
}

build() {
  # Keep Cargo's locked workspace build aligned with CI and reproducible
  # package metadata.
  cd "${pkgname}-${pkgver}"
  cargo build --workspace --release --locked
}

check() {
  # Run the same release-mode tests that guard the shipped binary.
  cd "${pkgname}-${pkgver}"
  cargo test --workspace --release --locked
}

package() {
  # Install only the binary, launch helpers, configuration examples, and
  # documentation required by the greetd integration.
  cd "${pkgname}-${pkgver}"

  install -Dm755 "$(_cargo_target_dir)/release/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm755 packaging/greetd/argvus-greeter-setup \
    "${pkgdir}/usr/bin/argvus-greeter-setup"
  install -Dm755 packaging/greetd/argvus-greeter-session \
    "${pkgdir}/usr/bin/argvus-greeter-session"
  install -Dm755 packaging/greetd/argvus-greeter-tui \
    "${pkgdir}/usr/bin/argvus-greeter-tui"
  install -Dm755 "$(_cargo_target_dir)/release/argvus-greeter-handoff" \
    "${pkgdir}/usr/lib/argvus/greeter/handoff"

  install -Dm644 packaging/greetd/greeter.toml \
    "${pkgdir}/etc/argvus/greeter.toml"
  install -Dm644 packaging/greetd/hyprland-argvus-greeter.conf \
    "${pkgdir}/etc/argvus/hyprland-argvus-greeter.conf"
  install -Dm644 packaging/greetd/hyprland-argvus-greeter.lua \
    "${pkgdir}/etc/argvus/hyprland-argvus-greeter.lua"
  install -Dm644 packaging/greetd/argvus-greeter-tmpfiles.conf \
    "${pkgdir}/usr/lib/tmpfiles.d/argvus-greeter.conf"

  install -Dm644 packaging/greetd/config.toml \
    "${pkgdir}/usr/share/doc/${pkgname}/greetd-config.toml"

  install -Dm644 README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
