#!/usr/bin/env bash
# Keep CI-installed package behavior identical to local Arch installations.
post_install() {
  cat <<'EOF'
==> To use Argvus Greeter with greetd, run:
==>   sudo argvus-greeter-setup --enable
==>
==> Use --now instead of --enable to restart greetd.service immediately.
EOF
}

post_upgrade() {
  post_install
}
