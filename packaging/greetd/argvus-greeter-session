#!/usr/bin/env sh
# Launch the minimal Hyprland compositor used only by the greetd greeter.

set -eu

# Allow package upgrades to replace only the exact known legacy configuration;
# administrator-owned custom paths must remain untouched.
CONFIG="${ARGVUS_GREETER_HYPRLAND_CONFIG:-/etc/argvus/hyprland-argvus-greeter.lua}"

# Pacman preserves modified backup files and writes the new package version to
# a .pacnew file. The old configuration launched the TUI directly on the VT,
# while the current one must launch it through argvus-tui-terminal. Use the
# package-provided migration automatically when that exact legacy transition
# is present; custom configurations and explicit overrides remain untouched.
PACNEW="${CONFIG}.pacnew"
if [ "$CONFIG" = "/etc/argvus/hyprland-argvus-greeter.lua" ] \
  && [ -f "$PACNEW" ] \
  && grep -Fq 'hl.exec_cmd("/usr/bin/argvus-greeter-tui")' "$PACNEW" \
  && grep -Fq "hl.exec_cmd(\"sh -lc '/usr/bin/argvus-greeter; hyprctl dispatch exit'\")" "$CONFIG"; then
  CONFIG="$PACNEW"
fi

# greetd may provide "/" as HOME for the greeter user.
# GTK/GSettings and other desktop components require a writable HOME.
if [ "${HOME:-}" = "/" ] || [ -z "${HOME:-}" ]; then
  # greetd may deliberately provide an unusable HOME; use runtime storage so
  # Kitty, Hyprland, and the ARGVUS bootstrap can still write private state.
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    HOME="${XDG_RUNTIME_DIR}/argvus-greeter/home"
  else
    HOME="/tmp/argvus-greeter-$(id -u)/home"
  fi

  export HOME
fi

# Create a private writable HOME for the greeter.
mkdir -p "$HOME"
chmod 700 "$HOME" 2>/dev/null || true

# Desktop/XDG environment for the greeter.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

mkdir -p \
  "$XDG_CONFIG_HOME" \
  "$XDG_CACHE_HOME" \
  "$XDG_DATA_HOME" \
  "$XDG_STATE_HOME"

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-argvus-greeter}"
export XDG_SESSION_TYPE="wayland"
export GDK_BACKEND="${GDK_BACKEND:-wayland}"

# Keep greeter state/logs in the runtime directory.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  # Runtime state disappears with the session and cannot pollute the user's
  # persistent configuration before authentication.
  STATE_DIR="${XDG_RUNTIME_DIR}/argvus-greeter"
else
  STATE_DIR="${XDG_STATE_HOME}/argvus-greeter"
fi

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true

LOG="$STATE_DIR/session.log"

# Clear the active login VT before the graphical greeter takes over.
if [ -w /dev/tty1 ]; then
  printf '\033c' >/dev/tty1 2>/dev/null || true
fi

# Detect virtual machines.
#
# The greeter uses software OpenGL in virtual machines because accelerated
# OpenGL may be unreliable for GTK4/GSK rendering in the guest environment.
#
# Containers are intentionally excluded: systemd-detect-virt also detects
# containers, but they are not the target of this workaround.
is_virtual_machine() {
  # Restrict the workaround to actual VMs; container detection is intentionally
  # excluded because it does not imply unreliable accelerated rendering.
  command -v systemd-detect-virt >/dev/null 2>&1 || return 1

  case "$(systemd-detect-virt 2>/dev/null || true)" in
    oracle|kvm|qemu|vmware|microsoft|xen|parallels|bhyve)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if is_virtual_machine; then
  VIRT="$(systemd-detect-virt 2>/dev/null || true)"

  export LIBGL_ALWAYS_SOFTWARE=1

  printf '%s\n' \
    "argvus-greeter-session: virtual machine detected (${VIRT}); using software OpenGL." \
    >> "$LOG"
fi

# Start the minimal Hyprland compositor. The command variants cover Arch's
# executable naming and the development launcher without changing policy.
if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland -- --config "$CONFIG" >> "$LOG" 2>&1
fi

if command -v Hyprland >/dev/null 2>&1; then
  exec Hyprland --config "$CONFIG" >> "$LOG" 2>&1
fi

if command -v hyprland >/dev/null 2>&1; then
  exec hyprland --config "$CONFIG" >> "$LOG" 2>&1
fi

printf '%s\n' \
  "argvus-greeter-session: Hyprland executable not found." >> "$LOG"

exit 127
