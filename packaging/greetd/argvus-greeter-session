#!/usr/bin/env sh
# Launch the minimal Hyprland compositor used only by the greetd greeter.

set -eu

CONFIG="${ARGVUS_GREETER_HYPRLAND_CONFIG:-/etc/argvus/hyprland-argvus-greeter.lua}"

# greetd may provide "/" as HOME for the greeter user.
# GTK/GSettings and other desktop components require a writable HOME.
if [ "${HOME:-}" = "/" ] || [ -z "${HOME:-}" ]; then
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    HOME="${XDG_RUNTIME_DIR}/argvus-greeter/home"
  else
    HOME="/tmp/argvus-greeter-$(id -u)/home"
  fi

  export HOME
fi

# Create a private writable HOME for the greeter.
mkdir -p "$HOME"
chmod 700 "$HOME" 2>/dev/null || true

# Desktop/XDG environment for the greeter.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

mkdir -p \
  "$XDG_CONFIG_HOME" \
  "$XDG_CACHE_HOME" \
  "$XDG_DATA_HOME" \
  "$XDG_STATE_HOME"

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-argvus-greeter}"
export XDG_SESSION_TYPE="wayland"
export GDK_BACKEND="${GDK_BACKEND:-wayland}"

# Keep greeter state/logs in the runtime directory.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  STATE_DIR="${XDG_RUNTIME_DIR}/argvus-greeter"
else
  STATE_DIR="${XDG_STATE_HOME}/argvus-greeter"
fi

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true

LOG="$STATE_DIR/session.log"

# Clear the active login VT before the graphical greeter takes over.
if [ -w /dev/tty1 ]; then
  printf '\033c' >/dev/tty1 2>/dev/null || true
fi

# Start the minimal Hyprland compositor.
if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland -- --config "$CONFIG" >> "$LOG" 2>&1
fi

if command -v Hyprland >/dev/null 2>&1; then
  exec Hyprland --config "$CONFIG" >> "$LOG" 2>&1
fi

if command -v hyprland >/dev/null 2>&1; then
  exec hyprland --config "$CONFIG" >> "$LOG" 2>&1
fi

printf '%s\n' \
  "argvus-greeter-session: Hyprland executable not found." >> "$LOG"

exit 127
